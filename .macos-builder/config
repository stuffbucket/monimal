# Client contract for the private stuffbucket/macos-builder pipeline.
#
# The builder checks this repository out at a tag, reads THIS file, runs
# ./.macos-builder/build.sh to produce the .app, then owns the whole tail it is
# never safe to hand a public repo: top-level sign, dmg, notarize, staple,
# sha256, and upload onto this repo's release at that tag.
#
# The vendored packages/maximal/.macos-builder/ is NOT this file. It is a test
# fixture copied from the standalone maximal repo and targets a different
# layout (npm, client/ at the root). The builder reads the CHECKOUT ROOT only.
# See RELEASING.md.

# Where build.sh leaves the bundle, relative to the checkout root.
# @electron/packager writes out/<productName>-darwin-<arch>/, productName is
# "Maximal" in packages/maximal/client/package.json, and build.sh pins --arch,
# so this literal path is always what appears.
app_path = packages/maximal/client/out/Maximal-darwin-arm64/Maximal.app

volname = Maximal

# MUST equal appBundleId in packages/maximal/client/forge.config.ts AND
# bundle_id_allowed in the builder's clients/stuffbucket/<repo>.policy. A
# mismatch is caught by the builder's policy gate only AFTER a full build.
bundle_id = co.stuffbucket.maximal

# Builder-owned, enumerated by name (never a path). bun-runtime is the superset
# that covers Electron's V8 and the Bun/JavaScriptCore sidecar in one profile:
# allow-jit, allow-unsigned-executable-memory, disable-library-validation,
# network.
entitlements = bun-runtime

# Sign every nested code item with that same profile, deepest-first, before the
# top-level seal. An Electron bundle nests four Helper .apps and the Electron
# Framework, and a bundle must be signed as a DIRECTORY so the seal covers its
# Info.plist and structure — which sign_nested cannot express, since it takes
# regular files only.
#
# This repository does not sign: the producer runs with the keychain locked and
# SIGN_IDENTITY="-". The builder owns every codesign call.
sign_walk = bun-runtime

# Two artifacts, for two different jobs.
#
# dmg      what a person downloads and drags to /Applications.
# updater  a gzipped tar of the .app plus a detached Ed25519 signature. It is
#          the artifact an in-app updater consumes, and it is the only one CI
#          can prove anything about from Ubuntu: a tar can be listed, an APFS
#          disk image cannot.
#
# NOTE what does NOT come from this line. The .app inside the dmg carries its own
# notarization ticket because the builder staples the bundle BEFORE hdiutil seals
# it into the image, not because `updater` is listed here. Requesting `updater`
# alone would leave the dmg exactly as it was: the builder's updater path staples
# the bundle outside the image, after 3a has already copied it in.
#
# REQUIRES the builder policy to permit both. `artifact_allowed` for this repo
# must list dmg AND updater, or the policy gate rejects the build — and it does
# so only AFTER a full 20-40 minute run. See RELEASING.md → Onboarding, step 1.
#
# Producing the updater artifact is NOT operating an update channel. Nothing here
# may write an update manifest to https://mxml.sh: that manifest is committed in
# stuffbucket/maximal, is pinned at v0.4.41, and the installed Tauri client reads
# it. See RELEASING.md → mxml.sh.
artifact = dmg,updater

# THE single owner of the asset name. {tag} is the full tag, {version} the tag
# without its leading v. .github/workflows/release.yml parses this file to learn
# what to wait for rather than restating the name. The checksum arrives beside
# it as <dmg_name>.sha256.
dmg_name = maximal-{tag}-darwin-arm64.dmg

# Same substitution as dmg_name, and the same single-owner rule: release.yml
# parses this to learn what to wait for. The builder requires the name to end in
# .app.tar.gz, and lands three files — <updater_name>, <updater_name>.sig
# (Ed25519, for a future in-app updater) and <updater_name>.sha256.
updater_name = maximal-{tag}-darwin-arm64.app.tar.gz
