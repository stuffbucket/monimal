{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "mise.toml",
    "mise.lock",
    ".nvmrc",
    ".bun-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/resources/bin/**",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "maximal-client#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["MAXIMAL_CORE_TARGET", "MAXIMAL_GIT_SHA"]
    },
    "maximal-site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/resources/bin/**",
        "$TURBO_ROOT$/packages/maximal/docs/guide/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/pr-artifacts/**"
      ],
      "env": [
        "MAXIMAL_TEST_CONTAINER",
        "MAXIMAL_TEST_HOST",
        "MAXIMAL_TEST_TRACE"
      ],
      "passThroughEnv": [
        "APPDATA",
        "CLAUDE_CONFIG_DIR",
        "COPILOT_API_HOME",
        "HOME",
        "LOCALAPPDATA",
        "MAXIMAL_TEST_ROOT",
        "USERPROFILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME"
      ]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "lint": {
      "dependsOn": ["topo", "^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
