{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "cacheMaxAge": "7d",
  "cacheMaxSize": "1GB",
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "mise.toml",
    "mise.lock",
    ".nvmrc",
    ".bun-version"
  ],
  "globalEnv": [
    "COPILOT_API_CREDENTIAL_HOME",
    "COPILOT_API_ENTERPRISE_URL",
    "MAXIMAL_HOME_POLICY",
    "COPILOT_API_OAUTH_APP",
    "MAXIMAL_API_SQLITE_DB_PATH"
  ],
  "tasks": {
    "analyze": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/architecture-analysis.json",
        "$TURBO_ROOT$/architecture-analysis.schema.json",
        "$TURBO_ROOT$/packages/maximal-core/scripts/analysis/**",
        "$TURBO_ROOT$/packages/maximal-core/scripts/analyze.ts",
        "$TURBO_ROOT$/scripts/architecture-graph.mjs",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/resources/bin/**",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
        ],
      "description": "Build package outputs after building workspace dependencies."
    },
    "token:inventory": {
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "description": "Build the workspace-wide Style Dictionary token inventory."
    },
    "token:check": {
      "dependsOn": ["token:inventory"],
      "outputs": [],
      "description": "Enforce the down-only warning ratchet for token migration issues."
    },
    "//#check:network-literals": {
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/research_log/**",
        "!$TURBO_ROOT$/.claude/**",
        "!$TURBO_ROOT$/.github/pr-artifacts/**"
      ],
      "description": "Enforce the workspace-wide network literal ratchet."
    },
    "//#check:cross-package-duplicates": {
      "outputs": ["reports/cross-package-duplicates/**"],
      "inputs": [
        "$TURBO_ROOT$/architecture-analysis.json",
        "$TURBO_ROOT$/scripts/check-cross-package-duplicates.mjs",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "description": "Enforce the down-only cross-package duplicate ratchet."
    },
    "@maximal/eslint-config#check:unsafe-type-assertions": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "description": "Enforce the workspace-wide unsafe TypeScript assertion ratchet."
    },
    "@maximal/maximal-settings#migration:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "description": "Enforce the workspace-wide application settings migration ratchet."
    },
    "@maximal/maximal-settings#security:check": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-lock.yaml"
      ],
      "description": "Verify the reviewed settings dependency graph and checked-in SBOM."
    },
    "@maximal/maximal-core#check:deep:host:after-workspace": {
      "dependsOn": ["build", "typecheck", "lint"],
      "outputs": [],
      "description": "Run Core's remaining host checks after workspace build, typecheck, and lint."
    },
    "@maximal/maximal-client#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@maximal/design-tokens#build": {
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "description": "Enforce the workspace-wide design token and icon metric ratchet."
    },
    "maximal-desktop#build": {
      "dependsOn": ["^build", "@maximal/maximal#build"],
      "cache": false,
      "env": ["MAXIMAL_CORE_OUT", "MAXIMAL_CORE_REF", "MAXIMAL_CORE_TARGET", "MAXIMAL_GIT_SHA"],
      "description": "Build the Maximal composition and UI dependencies before compiling the desktop sidecar."
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["MONIMAL_WORKSPACE_TASK"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Check package types against built workspace dependencies."
    },
    "@maximal/maximal-settings#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "description": "Typecheck public-contract tests after building this package."
    },
    "@maximal/maximal-logging#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "description": "Typecheck public-contract tests after building this package."
    },
    "test": {
      "dependsOn": ["analyze", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/pr-artifacts/**"
      ],
      "env": [
        "MAXIMAL_TEST_CONTAINER",
        "MAXIMAL_TEST_HOST",
        "MAXIMAL_TEST_TRACE"
      ],
      "passThroughEnv": [
        "APPDATA",
        "CLAUDE_CONFIG_DIR",
        "HOME",
        "LOCALAPPDATA",
        "MAXIMAL_HOME",
        "MAXIMAL_TEST_ROOT",
        "USERPROFILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME"
      ],
      "description": "Run package tests inside a root-managed isolated native or Docker environment."
    },
    "transit": {
      "dependsOn": ["^transit"],
      "description": "Propagate dependency changes without running package scripts."
    },
    "lint": {
      "dependsOn": ["transit", "^build"],
      "outputs": [],
      "passThroughEnv": ["MONIMAL_WORKSPACE_TASK"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Lint packages against built dependencies while tracking dependency changes."
    },
    "@maximal/maximal-logging#lint": {
      "dependsOn": ["transit", "^build"],
      "cache": false,
      "outputs": [],
      "description": "Rescan current runtime source for legacy logging on every lint run."
    },
    "@maximal/eslint-config#lint": {
      "dependsOn": ["transit", "^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**"
      ],
      "description": "Lint shared configuration and rescan workspace-wide renderer style policies."
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Create environment-dependent package artifacts."
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["MAXIMAL_*", "XDG_CONFIG_HOME"],
      "description": "Build workspace dependencies, then run a package's interactive development process."
    },
    "dev:context": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "description": "Launch the focused context-window visualization development lab."
    },
    "storybook": {
      "dependsOn": [
        "@maximal/maximal-electron#build",
        "@maximal/maximal-harness#build"
      ],
      "cache": false,
      "persistent": true,
      "description": "Launch the workspace Storybook integration."
    },
    "storybook:build": {
      "dependsOn": [
        "@maximal/maximal-electron#build",
        "@maximal/maximal-harness#build"
      ],
      "outputs": ["storybook-static/**"],
      "description": "Build the workspace Storybook integration."
    },
    "storybook:check": {
      "dependsOn": [
        "@maximal/maximal-electron#build",
        "@maximal/maximal-harness#build"
      ],
      "cache": false,
      "outputs": [],
      "description": "Render, play, and accessibility-check workspace stories."
    },
    "maximal-desktop#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "description": "Build the sidecar, then launch the Maximal desktop app."
    }
  }
}
