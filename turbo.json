{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-lock.yaml",
    ".npmrc",
    "pnpm-workspace.yaml",
    "mise.toml",
    "mise.lock",
    ".nvmrc",
    ".bun-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**", "!reports/**"]
    },
    "maximal-client#build": {
      "dependsOn": ["^build"],
      "outputs": ["resources/bin/**"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**", "!reports/**"],
      "env": ["GITHUB_SHA"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**", "!reports/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["reports/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!reports/**",
        "!.github/pr-artifacts/**"
      ],
      "env": ["MAXIMAL_TEST_TRACE"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**", "!reports/**"]
    },
    "package": {
      "dependsOn": ["build", "^build"],
      "outputs": ["out/**", ".vite/**"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**", "!reports/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
