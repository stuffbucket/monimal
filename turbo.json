{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "mise.toml",
    "mise.lock",
    ".nvmrc",
    ".bun-version"
  ],
  "globalEnv": [
    "COPILOT_API_CREDENTIAL_HOME",
    "COPILOT_API_ENTERPRISE_URL",
    "MAXIMAL_HOME",
    "MAXIMAL_HOME_POLICY",
    "COPILOT_API_OAUTH_APP",
    "MAXIMAL_API_SQLITE_DB_PATH"
  ],
  "tasks": {
    "analyze": {
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/architecture-analysis.json",
        "$TURBO_ROOT$/architecture-analysis.schema.json",
        "$TURBO_ROOT$/packages/maximal-core/scripts/analysis/**",
        "$TURBO_ROOT$/packages/maximal-core/scripts/analyze.ts",
        "$TURBO_ROOT$/scripts/architecture-graph.mjs",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/resources/bin/**",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
        ],
      "description": "Build package outputs after building workspace dependencies."
    },
    "token:inventory": {
      "outputs": ["dist/**"],
      "description": "Build the workspace-wide Style Dictionary token inventory."
    },
    "token:check": {
      "dependsOn": ["token:inventory"],
      "outputs": [],
      "description": "Enforce the down-only warning ratchet for token migration issues."
    },
    "@maximal/maximal-client#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "maximal-desktop#build": {
      "dependsOn": ["^build", "@maximal/maximal#build"],
      "cache": false,
      "env": ["MAXIMAL_CORE_OUT", "MAXIMAL_CORE_REF", "MAXIMAL_CORE_TARGET", "MAXIMAL_GIT_SHA"],
      "description": "Build the Maximal composition and UI dependencies before compiling the desktop sidecar."
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["MONIMAL_WORKSPACE_TASK"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Check package types against built workspace dependencies."
    },
    "@maximal/maximal-settings#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "description": "Typecheck public-contract tests after building this package."
    },
    "@maximal/maximal-logging#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "description": "Typecheck public-contract tests after building this package."
    },
    "test": {
      "dependsOn": ["analyze", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/pr-artifacts/**"
      ],
      "env": [
        "MAXIMAL_TEST_CONTAINER",
        "MAXIMAL_TEST_HOST",
        "MAXIMAL_TEST_TRACE"
      ],
      "passThroughEnv": [
        "APPDATA",
        "CLAUDE_CONFIG_DIR",
        "HOME",
        "LOCALAPPDATA",
        "MAXIMAL_TEST_ROOT",
        "USERPROFILE",
        "XDG_CACHE_HOME",
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_STATE_HOME"
      ],
      "description": "Run package tests inside a root-managed isolated native or Docker environment."
    },
    "transit": {
      "dependsOn": ["^transit"],
      "description": "Propagate dependency changes without running package scripts."
    },
    "lint": {
      "dependsOn": ["transit", "^build"],
      "outputs": [],
      "passThroughEnv": ["MONIMAL_WORKSPACE_TASK"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Lint packages against built dependencies while tracking dependency changes."
    },
    "@maximal/maximal-logging#lint": {
      "dependsOn": ["transit", "^build"],
      "cache": false,
      "outputs": [],
      "description": "Rescan current runtime source for legacy logging on every lint run."
    },
    "package": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!research_log/**",
        "!.claude/**",
        "!.github/**"
      ],
      "description": "Create environment-dependent package artifacts."
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["MAXIMAL_*", "XDG_CONFIG_HOME"],
      "description": "Build workspace dependencies, then run a package's interactive development process."
    },
    "dev:context": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "description": "Launch the focused context-window visualization development lab."
    },
    "maximal-desktop#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "description": "Build the sidecar, then launch the Maximal desktop app."
    }
  }
}
