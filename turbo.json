{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".npmrc",
    "pnpm-workspace.yaml",
    "mise.toml",
    "mise.lock",
    ".nvmrc",
    ".bun-version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**"]
    },
    "maximal-client#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "maximal-site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/maximal/docs/guide/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/pr-artifacts/**"],
      "env": ["MAXIMAL_TEST_TRACE"]
    },
    "topo": {
      "dependsOn": ["^topo"]
    },
    "lint": {
      "dependsOn": ["topo"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**"]
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["out/**", ".vite/**"],
      "inputs": ["$TURBO_DEFAULT$", "!research_log/**", "!.claude/**", "!.github/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
