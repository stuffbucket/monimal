{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace Storybook integration for Maximal renderer packages.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "types": "./src/test.ts",
      "default": "./src/test.ts"
    },
    "./storybook-server": "./storybook-server.mjs"
  },
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test storybook-server.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@storybook/react-vite": "10.5.10",
    "eslint": "^10.9.1",
    "storybook": "10.5.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
