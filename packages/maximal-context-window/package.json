{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-context-window",
  "version": "0.0.0",
  "private": true,
  "description": "Renderer-only ASCII context-window visualization for Maximal traffic sessions.",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --external react --external @maximal/maximal-data-visualization --external @maximal/maximal-electron --external @maximal/maximal-observability-contract --out-dir dist && cp src/styles.css dist/styles.css",
    "dev:context": "vite --config lab/vite.config.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maximal/maximal-data-visualization": "workspace:*",
    "@maximal/maximal-observability-contract": "workspace:*"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@maximal/maximal-electron": "workspace:*",
    "@maximal/maximal-terminal": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@maximal/maximal-electron": "^0.0.9",
    "react": ">=18.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
