{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-runtime-gliner25",
  "version": "0.0.0",
  "private": true,
  "description": "Cordis provider-host integration for Maximal GLiNER2.5 System One models.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@maximal/maximal-model-catalog": "workspace:*",
    "@maximal/maximal-models": "workspace:*",
    "@maximal/maximal-provider-decision-model": "workspace:*",
    "@maximal/maximal-provider-gliner25": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8"
  },
  "engines": {
    "node": ">=24"
  }
}
