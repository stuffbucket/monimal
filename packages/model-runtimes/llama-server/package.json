{
  "name": "@stuffbucket/llama-server",
  "version": "0.0.0",
  "private": true,
  "description": "Cordis/DSH runner plugin for private standalone llama.cpp servers.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@stuffbucket/eslint-config": "workspace:*",
    "@stuffbucket/local-model-registry": "workspace:*",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@stuffbucket/local-model-registry": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
