{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace-wide design token inventory and migration ratchet.",
  "type": "module",
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "node scripts/build-inventory.mjs",
    "lint": "eslint .",
    "test": "node --test",
    "token:inventory": "node scripts/build-inventory.mjs",
    "token:check": "node scripts/check-inventory.mjs",
    "typecheck": "node --check scripts/build-inventory.mjs && node --check scripts/check-inventory.mjs && node --check scripts/inventory.mjs"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "eslint": "^10.11.0",
    "style-dictionary": "https://codeload.github.com/style-dictionary/style-dictionary/tar.gz/489abdfcf6c4a23c35e9d4e85ae93b9c02d9cf4a"
  },
  "engines": {
    "node": ">=24"
  }
}
