{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Named explicitly because TypeScript 6/7 no longer picks it up on its own.
    // `lib` is ESNext-only, so the fetch/timer/AbortController globals this
    // package uses come from @types/bun; without this the declaration build
    // fails on RequestInit, Response, AbortController and setTimeout.
    // downstream/tsconfig*.json deliberately keeps `types: []` and is
    // unaffected -- it does not extend this file.
    "types": ["bun"],

    "allowJs": true,
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // tsup injects `baseUrl` when it generates declarations, and TypeScript 6
    // errors on it because TypeScript 7 drops it. Ours is not the config that
    // sets it -- `paths` below resolves relative to this file, which needs no
    // baseUrl -- so this silences a deprecation we do not own. Remove it once
    // tsup stops emitting baseUrl.
    "ignoreDeprecations": "6.0",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // `downstream/check.ts` is the runner for the downstream-contract typecheck and
  // is checked here. `downstream/src/**` is deliberately NOT included: those files
  // must only ever be compiled by downstream/tsconfig*.json, which has no `~/*`
  // paths alias — resolving them through this config would defeat the fixture.
  //
  // `scripts/**` is included because nothing else typechecked it. `tsc` covered
  // only what `src/`/`tests/` happened to import (measure-baseline.ts and
  // verify-build.ts, via their tests); `typecheck:ops` covers `scripts/ops/`
  // only, and behind a path filter (tooling-ci.yml). That left the dev and
  // release tooling — the e2e harness, and find-casts.ts, which backs the
  // `casts:check` CI gate — checked by nothing.
  // Adding it here surfaced a real defect: the sidecar harness declared its
  // child as `ChildProcessWithoutNullStreams` while spawning with
  // `stdio[0]: "ignore"`, so `child.stdin` was typed `Writable` and was `null`.
  "include": [
    "src/**/*",
    "tests/**/*",
    "eslint.config.js",
    "tsup.config.ts",
    "downstream/check.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
