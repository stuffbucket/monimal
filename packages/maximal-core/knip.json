{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "scripts/dev/*.ts", "scripts/ops/*.ts", "scripts/dev/win11/tests/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": [
    "electron",
    "undici",
    "@stryker-mutator/command-runner",
    "bumpp",
    "jscpd",
    "lint-staged"
  ],
  "ignoreBinaries": [
    "pgrep",
    "qemu-system-aarch64",
    "schtasks",
    "swtpm",
    "trufflehog"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": ["-internal"],
  "ignoreIssues": {
    "tests/**": ["files", "exports", "types"]
  },
  "ignore": ["src/lib/auth/copilot-online-retry.ts"]
}
