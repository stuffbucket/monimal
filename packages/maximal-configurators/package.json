{
  "name": "@maximal/maximal-configurators",
  "version": "0.0.0",
  "private": true,
  "description": "First-party client configurators for Maximal.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts src/pi.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint",
    "pi:models": "node src/pi/cli.ts",
    "smoke:pi": "node scripts/pi-smoke.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@maximal/maximal-core": "workspace:*",
    "@maximal/maximal-core-contract": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./dist/pi.js"
    ]
  }
}
