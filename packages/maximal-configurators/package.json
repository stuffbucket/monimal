{
  "name": "@stuffbucket/maximal-configurators",
  "version": "0.0.0",
  "private": true,
  "description": "First-party client configurators for Maximal.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@stuffbucket/maximal-core": "workspace:*"
  },
  "devDependencies": {
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
