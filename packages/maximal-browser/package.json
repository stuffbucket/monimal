{
  "name": "@maximal/maximal-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent-shareable browser sessions and Electron views for Maximal.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./styles.css": "./dist/renderer/styles.css"
  },
  "files": [
    "dist"
  ],
  "monimal": {
    "taskExemptions": {
      "package": "The consuming desktop application owns Electron packaging.",
      "start": "The consuming desktop application owns the Electron lifecycle."
    }
  },
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsc -p tsconfig.build.json && cp src/renderer/styles.css dist/renderer/styles.css",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@maximal/maximal-harness": "workspace:*",
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "electron": ">=30.0.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "electron": "44.4.5",
    "eslint": "^10.11.0",
    "react": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
