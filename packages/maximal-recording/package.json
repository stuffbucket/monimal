{
  "name": "@maximal/maximal-recording",
  "private": true,
  "type": "module",
  "description": "Optional window recording and video composition tooling for the Maximal desktop",
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "monimal": {
    "taskExemptions": {
      "package": "The consuming desktop application owns Electron packaging.",
      "start": "The consuming desktop application owns the Electron lifecycle."
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "compose": "node scripts/compose.mjs",
    "test": "vitest run",
    "test:rules": "playwright test --config e2e/demo/rules.config.ts",
    "mutate": "stryker run stryker.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.2",
    "electron": "44.4.5",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
