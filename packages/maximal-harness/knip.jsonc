{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The manifest exports point at `dist/`; these are the sources tsup builds them from.
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "src/host/index.ts",
    "src/renderer/index.ts",
    "src/renderer/Overlay.stories.tsx",
    "scripts/*.mjs",
    "tests/**/*.test.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    // Imported by src/styles.css; Knip's TypeScript project does not traverse CSS imports.
    "@fontsource/opendyslexic",
    // The command runner is built into Stryker core but is inferred as a plugin.
    "@stryker-mutator/command-runner"
  ],
  "ignoreExportsUsedInFile": true
}
