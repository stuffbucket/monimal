{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // The manifest exports point at `dist/`; these are the sources tsup builds them from.
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "src/host/index.ts",
    "src/renderer/index.ts",
    "scripts/*.mjs",
    "tests/**/*.test.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.{ts,tsx}"],
  // The command runner is built into Stryker core but is inferred as a plugin.
  "ignoreDependencies": ["@stryker-mutator/command-runner"],
  "ignoreExportsUsedInFile": true
}
