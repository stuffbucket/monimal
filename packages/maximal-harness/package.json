{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Composable local agent harness for Maximal desktop clients.",
  "sideEffects": ["./dist/styles.css"],
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts" },
    "./host": { "types": "./dist/host/index.d.ts", "import": "./dist/host/index.js" },
    "./renderer": { "types": "./dist/renderer/index.d.ts", "import": "./dist/renderer/index.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/agent.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/host/index.ts src/renderer/index.ts --format esm --dts --target es2022 --external react --external react-dom --out-dir dist && cp src/styles.css dist/styles.css && node scripts/verify-exports.mjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutate": "stryker run stryker.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "analyze": "bun ../maximal-core/scripts/analyze.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@maximal/maximal-llama-cpp": "workspace:*",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@maximal/eslint-config": "workspace:*",
    "@maximal/maximal-electron": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@maximal/maximal-electron": "^0.0.9",
    "react": ">=18.0.0 <20.0.0"
  },
  "engines": { "node": ">=24" }
}
