{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@stuffbucket/maximal-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Composable local agent harness for Maximal desktop clients.",
  "sideEffects": ["./dist/styles.css"],
  "type": "module",
  "monimal": {
    "taskExemptions": {
      "package": "The consuming desktop host owns application packaging.",
      "start": "The consuming desktop host owns the application lifecycle."
    }
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./host": { "types": "./dist/host/index.d.ts", "import": "./dist/host/index.js" },
    "./renderer": { "types": "./dist/renderer/index.d.ts", "import": "./dist/renderer/index.js" },
    "./worker": { "types": "./dist/worker/index.d.ts", "import": "./dist/worker/index.js" },
    "./packaging": {
      "types": "./scripts/llama-packaging.d.mts",
      "import": "./scripts/llama-packaging.mjs"
    },
    "./verify": {
      "types": "./scripts/llama-package-checks.d.mts",
      "import": "./scripts/llama-package-checks.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/llama-packaging.mjs",
    "scripts/llama-packaging.d.mts",
    "scripts/llama-package-checks.mjs",
    "scripts/llama-package-checks.d.mts",
    "docs/agent.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/host/index.ts src/renderer/index.ts src/worker/index.ts --format esm --dts --clean --target es2022 --external electron --external react --external react-dom --external node-llama-cpp --out-dir dist && cp src/styles.css dist/styles.css",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutate": "stryker run stryker.config.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "typebox": "1.3.23"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stuffbucket/eslint-config": "workspace:*",
    "@stuffbucket/maximal-electron": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "44.1.0",
    "eslint": "^10.9.1",
    "node-llama-cpp": "3.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@stuffbucket/maximal-electron": "^0.0.9",
    "electron": ">=30.0.0",
    "node-llama-cpp": "3.20.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "engines": { "node": ">=24" }
}
