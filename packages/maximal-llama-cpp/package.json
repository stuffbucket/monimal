{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-llama-cpp",
  "version": "0.0.0",
  "description": "Standalone Electron-hosted llama.cpp provider, worker, and packaging policy.",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuffbucket/monimal"
  },
  "license": "MIT",
  "author": "stuffbucket",
  "sideEffects": [
    "./dist/worker/index.js"
  ],
  "type": "module",
  "monimal": {
    "taskExemptions": {
      "package": "The consuming Electron host owns application packaging.",
      "start": "The consuming Electron host owns the application lifecycle."
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./packaging": {
      "types": "./scripts/llama-packaging.d.mts",
      "import": "./scripts/llama-packaging.mjs"
    },
    "./verify": {
      "types": "./scripts/llama-package-checks.d.mts",
      "import": "./scripts/llama-package-checks.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llama-worker-contract.mjs",
    "llama-worker-contract.d.mts",
    "scripts/llama-packaging.mjs",
    "scripts/llama-packaging.d.mts",
    "scripts/llama-package-checks.mjs",
    "scripts/llama-package-checks.d.mts",
    "README.md"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts src/host/index.ts src/worker/index.ts --format esm --dts --clean --target node24 --external electron --external node-llama-cpp --out-dir dist",
    "lint": "eslint .",
    "mutate": "stryker run stryker.config.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-llama-cpp": "3.21.1"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "44.4.5",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "electron": ">=30.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
