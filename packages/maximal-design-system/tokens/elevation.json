  "elevation": {
    "$description": "Semantic elevation scale. Dark standard-resolution shadows are the default; generated CSS switches theme and resolution variants.",
    "$type": "shadow",
    "100": {
      "$description": "Minimal lift for elements that sit as part of the canvas.",
      "$value": "{elevation-reference.100.dark.standard}",
      "$extensions": {
        "dev.maximal.design-token": { "cssCustomProperties": ["--elevation-100"] },
        "dev.maximal.elevation": { "label": "Shapes", "examples": ["Canvas shapes", "Canvas sections", "Image shadows"] }
      }
    },
    "200": {
      "$description": "Canvas elements that sit distinctly above the canvas.",
      "$value": "{elevation-reference.200.dark.standard}",
      "$extensions": {
        "dev.maximal.design-token": { "cssCustomProperties": ["--elevation-200"] },
        "dev.maximal.elevation": { "label": "Stickies and comments", "examples": ["Stickies", "Comment pins"] }
      }
    },
    "300": {
      "$description": "Transient elements and objects actively lifted above the canvas.",
      "$value": "{elevation-reference.300.dark.standard}",
      "$extensions": {
        "dev.maximal.design-token": { "cssCustomProperties": ["--elevation-300"] },
        "dev.maximal.elevation": { "label": "Tooltips", "examples": ["Tooltips", "Dragged objects", "Comment previews"] }
      }
    },
    "400": {
      "$description": "Interface surfaces that appear above the canvas.",
      "$value": "{elevation-reference.400.dark.standard}",
      "$extensions": {
        "dev.maximal.design-token": { "cssCustomProperties": ["--elevation-400"] },
        "dev.maximal.elevation": { "label": "Menus and panels", "examples": ["Panels", "Menus", "Notifications"] }
      }
    },
    "500": {
      "$description": "Large views that appear above the broader interface.",
      "$value": "{elevation-reference.500.dark.standard}",
      "$extensions": {
        "dev.maximal.design-token": { "cssCustomProperties": ["--elevation-500"] },
        "dev.maximal.elevation": { "label": "Modals and dialogs", "examples": ["Modals", "Dialogs"] }
      }
    }
  }
