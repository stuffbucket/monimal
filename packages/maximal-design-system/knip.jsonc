{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "stories/**/*.stories.tsx",
    "src/**/*.test.{ts,tsx}",
    "scripts/*.mjs",
    "test/*.test.mjs"
  ],
  "project": [
    ".storybook/**/*.{ts,mdx}",
    "stories/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "test/*.test.mjs"
  ],
  "ignoreExportsUsedInFile": true
}
