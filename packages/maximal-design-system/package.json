{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Shared color system, design-token inventory, icon metrics, and design tools.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./color": "./src/color/index.ts",
    "./color/tools": "./src/color/tools.ts",
    "./components": "./src/components/index.ts",
    "./compositions": "./src/compositions/index.ts",
    "./icons": "./src/icons/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./theme": "./src/theme.ts",
    "./utilities": "./src/utilities/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./app.css": "./src/styles/app.css",
    "./tokens.css": "./dist/tokens/tokens.css"
  },
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "api:check": "maximal-ds-api-check .",
    "build": "pnpm run tokens:build && pnpm run quality:source && pnpm run policy:check && node scripts/check-inventory.mjs",
    "lint": "eslint .",
    "mutate": "pnpm --filter @maximal/maximal-design-system-tools run mutate:mds",
    "policy:check": "maximal-ds-policy-check .",
    "quality:check": "pnpm run quality:source && pnpm run policy:check && pnpm run test:coverage && pnpm run storybook:check && pnpm run storybook:acceptance && pnpm run mutate",
    "quality:source": "maximal-ds-source-quality .",
    "test": "node --test test/*.test.mjs && vitest run src",
    "test:coverage": "vitest run src --coverage",
    "storybook": "pnpm run tokens:build && node scripts/storybook-server.mjs start --catalog maximal-design-system --catalog-root .",
    "storybook:list": "node scripts/storybook-server.mjs list",
    "storybook:stop": "node scripts/storybook-server.mjs stop",
    "storybook:build": "pnpm run tokens:build && storybook build",
    "storybook:acceptance": "pnpm run tokens:build && maximal-storybook-check . --profiles=reflow-320,zoom-200-equivalent,forced-colors,reduced-motion,text-spacing",
    "storybook:check": "pnpm run tokens:build && maximal-storybook-check .",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "token:inventory": "node scripts/build-inventory.mjs",
    "token:check": "node scripts/check-inventory.mjs",
    "typecheck": "node --check style-dictionary.config.mjs && node --check scripts/build-inventory.mjs && node --check scripts/check-inventory.mjs && node --check scripts/inventory.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@maximal/maximal-storybook": "workspace:*",
    "@maximal/maximal-design-system-tools": "workspace:*",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.9.1",
    "react-dom": "^19.2.8",
    "storybook": "10.5.10",
    "style-dictionary": "https://codeload.github.com/style-dictionary/style-dictionary/tar.gz/489abdfcf6c4a23c35e9d4e85ae93b9c02d9cf4a",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
