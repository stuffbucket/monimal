{
  "name": "@stuffbucket/maximal-settings",
  "version": "0.0.0",
  "private": true,
  "description": "Typed layered settings and the workspace settings migration ratchet.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dependency-policy": {
      "types": "./scripts/dependency-policy.d.cts",
      "import": "./scripts/dependency-policy.cjs",
      "require": "./scripts/dependency-policy.cjs"
    },
    "./migration": {
      "types": "./scripts/migration.d.mts",
      "import": "./scripts/migration.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts",
    "migration-baseline.json",
    "dependency-review.json",
    "SBOM.cdx.json"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint .",
    "migration:check": "node scripts/migration.mjs",
    "migration:update": "node scripts/migration.mjs --update",
    "sbom": "node scripts/sbom.mjs",
    "security:audit": "pnpm audit --prod --audit-level=low",
    "security:check": "node scripts/sbom.mjs --check",
    "test": "pnpm run security:check && pnpm run build && node --test tests/*.test.ts",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "deepmerge": "4.3.1",
    "lilconfig": "3.1.3",
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "8.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/node": "^26.6.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
