{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "scripts/**/*.{mjs,ts}",
    "tests/**/*.test.ts",
    "src/**/*.stories.{ts,tsx}",
    "src/renderer/index.ts",
    "src/host/run-main.ts",
    "src/host/host-window.ts",
    "src/host/electron-terminal.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,mts,ts}",
    "tests/**/*.ts",
    "*.{ts,mts}"
  ],
  "ignoreFiles": [
    "scripts/**/*.d.mts"
  ],
  "stryker": {
    "config": ["stryker.conf.json", "stryker.static.conf.mjs"]
  },
  "ignoreExportsUsedInFile": true
}