{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/host/**/*.ts", "src/preload/bridge.ts"],
  "exclude": ["node_modules", "out", ".vite", "dist", "tests", "e2e"]
}
