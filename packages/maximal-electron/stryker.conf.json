{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The complete mutation scope. The workspace runner narrows it to changed or explicit ranges for development and shards it only across isolated checkouts. `scripts/mutation-scope.mjs` derives every file under `src/` and `scripts/` that Stryker can run, and fails when one is on neither this list nor its deferred list. Anything importing `electron` or React for a value needs a real Electron runtime or browser and cannot run here. `scripts/mutation-report.mjs` verifies the result shape because the score alone says nothing about missing mutants or non-assertion kills.",
  "packageManager": "npm",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.mts"
  },
  "mutate": [
    "scripts/component-css.mjs",
    "src/shared/urls.ts",
    "src/host/main-options.ts",
    "src/host/crash-artifacts.ts",
    "src/main/native/session-metadata.ts",
    "src/preload/capabilities.ts",
    "src/renderer/lib/data.ts",
    "src/renderer/lib/theme.ts",
    "src/main/native/ffmpeg.ts",
    "src/main/native/icons.ts",
    "src/renderer/lib/resolve-bridge.ts",
    "src/renderer/lib/contrast.ts",
    "src/renderer/lib/tab-adornment.ts",
    "src/renderer/lib/account.ts",
    "src/renderer/lib/settings.ts",
    "src/main/native/terminal-lab.ts",
    "src/main/native/self-check.ts",
    "src/renderer/lib/tab-transfer.ts",
    "scripts/terminal-package.mjs",
    "scripts/shell-variables.mjs",
    "scripts/electron-cache.mjs",
    "scripts/check-scope.mjs",
    "scripts/docs-claims.mjs",
    "scripts/fixture-imports.mjs",
    "scripts/peer-requirements.mjs",
    "scripts/peer-table.mjs"
  ],
  "reporters": [
    "progress",
    "clear-text",
    "html",
    "json"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "incrementalFile": "reports/mutation/incremental.json",
  "concurrency": 12,
  "timeoutMS": 30000,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "out",
    ".vite",
    "node_modules",
    "dist",
    "reports",
    "test-results",
    "playwright-report",
    "e2e"
  ]
}
