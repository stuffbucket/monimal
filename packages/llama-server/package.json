{
  "name": "@stuffbucket/llama-server",
  "version": "0.0.0",
  "private": true,
  "description": "Scaffold for the llama.cpp HTTP server adapter.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --out-dir dist",
    "lint": "eslint",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stuffbucket/eslint-config": "workspace:*",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
