{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-assets",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical Maximal brand assets and visual configuration.",
  "type": "module",
  "exports": {
    "./brand": {
      "types": "./src/brand.ts",
      "import": "./src/brand.ts"
    },
    "./package.json": "./package.json",
    "./terminal-icons": {
      "types": "./src/terminal-icons.ts",
      "import": "./src/terminal-icons.ts"
    }
  },
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsc6 --noEmit",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "tsc6 --noEmit"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
