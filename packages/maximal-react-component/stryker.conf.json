{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm test:unit"
  },
  "mutate": ["src/**/*.ts"],
  "reporters": ["progress", "clear-text", "json"],
  "tempDirName": "../../node_modules/.cache/stryker/maximal-react-component",
  "cleanTempDir": "always",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 8,
  "timeoutMS": 60000,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 90
  },
  "ignorePatterns": ["dist", "node_modules", "reports", "storybook-static"]
}
