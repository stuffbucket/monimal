{
  "name": "@maximal/maximal-react-component",
  "version": "0.0.0",
  "private": true,
  "description": "Development-time React component source inspection for Maximal.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "pnpm tokens:build && tsup src/index.ts src/client.ts --format esm --dts --clean --splitting false --target node24 --out-dir dist",
    "lint": "eslint",
    "mutate": "pnpm tokens:build && stryker run",
    "storybook": "pnpm tokens:build && node scripts/storybook-server.mjs start --catalog maximal-react-component --catalog-root .",
    "storybook:build": "pnpm tokens:build && storybook build",
    "test": "pnpm tokens:build && pnpm test:unit",
    "test:unit": "vitest run",
    "tokens:build": "node scripts/build-tokens.mjs",
    "typecheck": "pnpm tokens:build && tsc --noEmit"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@maximal/maximal-storybook": "workspace:*",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.5.10",
    "style-dictionary": "https://codeload.github.com/style-dictionary/style-dictionary/tar.gz/489abdfcf6c4a23c35e9d4e85ae93b9c02d9cf4a",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "vite": ">=7.0.0 <9.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
