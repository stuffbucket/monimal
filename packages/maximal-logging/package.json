{
  "name": "@stuffbucket/maximal-logging",
  "version": "0.0.0",
  "private": true,
  "description": "Persistent structured logging for Maximal runtimes.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "logging.toml"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --target node24 --external pino --out-dir dist",
    "lint": "eslint . && node scripts/check-migration.mjs",
    "test": "pnpm run build && node --test tests/*.test.ts",
    "typecheck": "tsc6 --noEmit"
  },
  "dependencies": {
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
