{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Portable spatial-canvas theme parsing and application must retain a complete mutation score.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run src/renderer/appearance.test.ts"
  },
  "mutate": [
    "src/renderer/appearance.ts:366:0-369:1",
    "src/renderer/appearance.ts:385:0-388:1",
    "src/renderer/appearance.ts:413:0-417:1",
    "src/renderer/appearance.ts:426:0-429:1",
    "src/renderer/appearance.ts:547:0-554:1",
    "src/renderer/appearance.ts:565:0-569:1"
  ],
  "reporters": ["progress", "clear-text", "html", "json"],
  "tempDirName": ".stryker-tmp/appearance",
  "cleanTempDir": "always",
  "htmlReporter": {
    "fileName": "reports/mutation/appearance/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/appearance/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "out",
    ".vite",
    "node_modules",
    "dist",
    "reports",
    "test-results",
    "playwright-report",
    "e2e"
  ]
}
