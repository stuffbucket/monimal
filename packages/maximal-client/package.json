{
  "name": "@maximal/maximal-client",
  "description": "Maximal product UI and shared desktop contracts.",
  "type": "commonjs",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./shared/host": "./src/shared/host.ts",
    "./shared/settings-sections": "./src/shared/settings-sections.ts",
    "./renderer/AppWorkspace": "./src/renderer/AppWorkspace.tsx",
    "./renderer/query-client": "./src/renderer/query-client.tsx",
    "./renderer/ThirdPartyLicensesDialog": "./src/renderer/ThirdPartyLicensesDialog.tsx",
    "./renderer/useAccountStatus": "./src/renderer/useAccountStatus.ts",
    "./renderer/settings/Settings": "./src/renderer/settings/Settings.tsx",
    "./renderer/settings/capabilities": "./src/renderer/settings/capabilities.ts",
    "./renderer/terminal/window-transfer": "./src/renderer/terminal/window-transfer.ts",
    "./renderer/traffic/source": "./src/renderer/traffic/source.ts",
    "./renderer/useTerminalTabs": "./src/renderer/useTerminalTabs.ts",
    "./renderer/unsaved-changes": "./src/renderer/unsaved-changes.tsx",
    "./renderer/theme": "./src/renderer/theme.ts",
    "./renderer/base": "./src/renderer/base.ts",
    "./renderer/harness/transport": "./src/renderer/harness/transport.ts"
  },
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsc --noEmit",
    "typecheck": "node ../../scripts/run-workspace-task.mjs typecheck",
    "typecheck:inner": "tsc --noEmit",
    "lint": "node ../../scripts/run-workspace-task.mjs lint",
    "lint:inner": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutate": "stryker run",
    "test:mutation": "vitest run --config vitest.mutation.config.mts",
    "test": "vitest run",
    "test:run": "vitest run",
    "mutate:general": "stryker run stryker.general.conf.json",
    "ui:preview": "pnpm --filter @maximal/maximal-electron run build:renderer && vite --config vite.preview.config.mts --host 127.0.0.1 --open /ui-preview.html",
    "ui:check": "pnpm --filter @maximal/maximal-electron run build:renderer && node scripts/ui-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "5.103.2",
    "@maximal/maximal-core-contract": "workspace:*",
    "@maximal/maximal-electron": "workspace:*",
    "@maximal/maximal-harness": "workspace:*",
    "@maximal/maximal-logging": "workspace:*",
    "@maximal/maximal-observability": "workspace:*",
    "@maximal/maximal-observability-contract": "workspace:*",
    "@maximal/maximal-ollama": "workspace:*",
    "@maximal/maximal-search": "workspace:*",
    "@maximal/maximal-terminal": "workspace:*",
    "@wterm/dom": "0.4.1",
    "@wterm/ghostty": "0.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
