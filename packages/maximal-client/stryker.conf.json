{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Manual, focused mutation testing. The command runner starts a fresh Vitest process per mutant for Vitest 5 compatibility. No mutation-score threshold gates normal development or CI.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm test:mutation"
  },
  "mutate": [
    "src/renderer/terminal-tab-organization.ts",
    "src/renderer/settings/Settings.tsx:1:0-111:0",
    "src/renderer/settings/Settings.tsx:539:0-546:1"
  ],
  "reporters": ["progress", "clear-text", "html", "json"],
  "tempDirName": ".stryker-tmp",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "coverageAnalysis": "off",
  "thresholds": {
    "break": null
  },
  "ignorePatterns": [
    "out",
    ".electron-dev",
    ".vite",
    "node_modules",
    "dist",
    "reports",
    "test-results",
    "playwright-report",
    "e2e"
  ]
}
