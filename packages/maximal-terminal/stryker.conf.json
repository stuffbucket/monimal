{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing, breaking below 100. `scripts/mutation-scope.mjs` fails when a module Stryker can run is on neither this list nor its deferred list; `scripts/mutation-report.mjs` reads the run back. Both apply the workspace's criteria in `../../scripts`. Modules importing React, xterm or wterm for a value are out of reach under Node.",
  "packageManager": "npm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.mts" },
  "mutate": [
    "src/grid.ts",
    "src/pane.ts",
    "src/host/connector.ts",
    "src/launch/command-connectors.ts",
    "src/launch/launcher.ts",
    "src/pty/mirrors.ts",
    "src/pty/ownership.ts",
    "src/pty/pane-documents.ts",
    "src/pty/session.ts",
    "src/pty/shell.ts",
    "src/pty/window-groups.ts",
    "src/renderer/ack.ts",
    "src/renderer/osc-title.ts",
    "src/renderer/sessions.ts",
    "src/renderer/tab.ts",
    "src/renderer/transport.ts",
    "src/renderer/workspace.ts",
    "src/tmux/control-host.ts",
    "src/tmux/control-protocol.ts",
    "src/tmux/projection-authority.ts",
    "src/tmux/projection-broker.ts",
    "src/tmux/projection-host.ts",
    "src/tmux/projection-owners.ts",
    "src/tmux/session-names.ts",
    "src/tmux/window-geometry.ts"
  ],
  "reporters": ["progress", "clear-text", "html", "json"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "concurrency": 12,
  "timeoutMS": 30000,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "ignorePatterns": ["dist", "node_modules", "reports"]
}
