{
  "name": "@maximal/maximal-terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal sessions, launchers, tmux projection, and React terminal views for maximal.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "mutate": "node ../../scripts/run-mutation.mjs",
    "mutate:all": "node ../../scripts/run-mutation.mjs --all",
    "mutate:incremental": "node ../../scripts/run-mutation.mjs --incremental",
    "mutate:merge-shards": "node ../../scripts/run-mutation.mjs --merge-shards=4",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@wterm/dom": "^0.4.1",
    "@wterm/ghostty": "^0.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": ">=1.2.0-beta.14",
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@maximal/eslint-config": "workspace:*",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wterm/dom": "0.5.0",
    "@wterm/ghostty": "0.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "eslint": "^10.11.0",
    "jsdom": "30.1.1",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
