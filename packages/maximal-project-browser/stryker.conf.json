{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Pure project-map state, camera, and geometry logic must retain a complete mutation score.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run tests/store.test.ts tests/view.test.ts tests/geometry.test.ts"
  },
  "mutate": [
    "src/store.ts:92:0-97:80",
    "src/store.ts:108:0-169:1",
    "src/store.ts:186:0-225:1",
    "src/view.ts:15:0-24:0",
    "src/geometry.ts:10:0-14:1"
  ],
  "reporters": ["progress", "clear-text", "html", "json"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "concurrency": 4,
  "timeoutMS": 30000,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "reports"
  ]
}
