{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@maximal/maximal-project-browser",
  "version": "0.0.0",
  "private": true,
  "description": "High-performance collaborative spatial project browser for Maximal renderers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --external react --external @maximal/maximal-electron --out-dir dist",
    "lint": "eslint",
    "mutate": "stryker run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maximal/maximal-electron": "workspace:*",
    "y-protocols": "1.0.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@maximal/eslint-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
