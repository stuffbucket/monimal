{
  "name": "@stuffbucket/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint 10 flat config for the monimal workspace.",
  "monimal": {
    "taskExemptions": {
      "build": "Source JavaScript modules are the published configuration.",
      "test": "Workspace consumer lint tasks exercise the shared configuration.",
      "typecheck": "The source-only JavaScript configuration has no TypeScript surface."
    }
  },
  "exports": {
    "./architecture": "./architecture.js",
    "./base": "./base.js",
    "./typescript": "./typescript.js",
    "./service": "./service.js"
  },
  "files": [
    "architecture.js",
    "base.js",
    "typescript.js",
    "service.js"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-package-json": "^1.8.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
