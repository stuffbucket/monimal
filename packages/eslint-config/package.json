{
  "name": "@maximal/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint 10 flat config for the monimal workspace.",
  "monimal": {
    "taskExemptions": {
      "build": "Source JavaScript modules are the published configuration.",
      "test": "Workspace consumer lint tasks exercise the shared configuration.",
      "typecheck": "The source-only JavaScript configuration has no TypeScript surface."
    }
  },
  "exports": {
    "./architecture": "./architecture.js",
    "./base": "./base.js",
    "./typescript": "./typescript.js",
    "./service": "./service.js"
  },
  "files": [
    "architecture.js",
    "base.js",
    "typescript.js",
    "service.js"
  ],
  "scripts": {
    "analyze": "bun ../maximal-core/scripts/analyze.ts",
    "check:runtime-style-injectors": "node scripts/check-runtime-style-injectors.mjs",
    "check:ui-query-primitives": "node scripts/check-ui-query-primitives.mjs",
    "lint": "eslint && node scripts/check-ui-query-primitives.mjs && node scripts/check-runtime-style-injectors.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-de-morgan": "^2.2.0",
    "eslint-plugin-package-json": "^1.10.0",
    "eslint-plugin-perfectionist": "^5.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  }
}
