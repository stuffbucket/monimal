{
  "name": "maximal-client",
  "description": "Electron client for maximal: spawns maximal-core and composes the stuffbucket/electron shell.",
  "type": "commonjs",
  "productName": "Maximal",
  "version": "0.0.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "analyze": "bun ../../maximal-core/scripts/analyze.ts",
    "build": "bun scripts/build-core.ts",
    "build:core": "bun scripts/build-core.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mutate": "stryker run",
    "test": "vitest run",
    "test:run": "vitest run",
    "dev": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "package": "electron-forge package",
    "verify:package": "node scripts/verify-package.mjs",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icon-png.mjs",
    "predev": "node scripts/gen-icon-png.mjs",
    "prestart": "node scripts/gen-icon-png.mjs",
    "prepackage": "node scripts/gen-icon-png.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@stuffbucket/local-model-registry": "workspace:*",
    "@stuffbucket/maximal-core": "workspace:*",
    "@stuffbucket/maximal-electron": "workspace:*",
    "@stuffbucket/maximal-harness": "workspace:*",
    "@stuffbucket/maximal-observability": "workspace:*",
    "@stuffbucket/maximal-observability-contract": "workspace:*",
    "@wterm/dom": "0.3.4",
    "@wterm/ghostty": "0.3.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^1.38.0",
    "node-llama-cpp": "3.20.0",
    "node-pty": "1.2.0-beta.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "stuffbucket-electron": "workspace:@stuffbucket/maximal-electron@*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-base": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^4.3.0",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
