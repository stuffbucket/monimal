{
  "name": "maximal-client",
  "description": "Electron client for maximal: spawns maximal-core and composes the stuffbucket/electron shell.",
  "type": "commonjs",
  "productName": "Maximal",
  "version": "0.0.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "build": "bun scripts/build-core.ts",
    "build:core": "bun scripts/build-core.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:run": "vitest run",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icon-png.mjs",
    "prestart": "node scripts/gen-icon-png.mjs",
    "prepackage": "node scripts/gen-icon-png.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@stuffbucket/maximal-core": "workspace:*",
    "ghostty-web": "^0.4.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "stuffbucket-electron": "workspace:@stuffbucket/maximal-electron@*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/packager": "^18.4.0",
    "@playwright/test": "^1.62.1",
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
