{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    // Named explicitly because TypeScript 7 no longer picks it up on its own.
    // This package declares no @types/node and gets Node's globals and module
    // declarations through @types/bun; without this every `node:*` import and
    // every `process`/`console` reference fails to resolve.
    "types": ["bun"],

    "allowJs": true,
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*", "scripts/**/*", "tests/**/*", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "build", "scripts/ops"]
}
