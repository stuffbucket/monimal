{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@stuffbucket/maximal",
  "version": "0.4.41",
  "description": "Local proxy that exposes GitHub Copilot as OpenAI- and Anthropic-compatible HTTP endpoints.",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible",
    "anthropic-compatible"
  ],
  "homepage": "https://github.com/stuffbucket/maximal",
  "bugs": "https://github.com/stuffbucket/maximal/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuffbucket/maximal"
  },
  "license": "MIT",
  "author": "stuffbucket",
  "type": "module",
  "bin": {
    "maximal": "./dist/main.js"
  },
  "files": [
    "dist",
    "THIRD-PARTY-LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check:deep": "bun run check:fast && bun test && bun run knip",
    "check:fast": "bun run lint:fast && bun run typecheck && bun run lint:all",
    "dev": "bun run --watch ./src/main.ts",
    "knip": "knip-bun",
    "lint": "eslint",
    "lint:all": "eslint .",
    "lint:fast": "oxlint",
    "prepack": "bun run build",
    "release:manual": "bumpp && bun publish --access public",
    "render-formula": "bun scripts/sync-homebrew-formula.ts",
    "sbom": "bun scripts/sbom.ts",
    "scan:secrets": "trufflehog filesystem . --no-verification --fail --no-update --exclude-paths .trufflehog-exclude",
    "start": "NODE_ENV=production bun run ./src/main.ts",
    "test": "bun test",
    "typecheck": "tsc",
    "verify:build": "bun scripts/dev/verify-build.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": [
      "bun run lint --fix",
      "bash scripts/secret-scan.sh"
    ]
  },
  "dependencies": {
    "@stuffbucket/maximal-core": "workspace:*",
    "@stuffbucket/maximal-dsh-host": "workspace:*",
    "@stuffbucket/maximal-provider-contract": "workspace:*"
  },
  "devDependencies": {
    "@stuffbucket/eslint-config": "workspace:*",
    "@types/bun": "^1.2.23",
    "bumpp": "^10.2.3",
    "eslint": "^10.8.1",
    "knip": "^5.64.1",
    "lint-staged": "^16.2.3",
    "oxlint": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
