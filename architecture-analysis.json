{
  "$schema": "./architecture-analysis.schema.json",
  "packages": {
    "@stuffbucket/anthropic-provider": {
      "root": "packages/model-runtimes/anthropic",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/eslint-config": {
      "root": "packages/eslint-config",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal": {
      "root": "packages/maximal",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-core": {
      "root": "packages/maximal-core",
      "existingRatchets": true
    },
    "@stuffbucket/maximal-models": {
      "root": "packages/maximal-models",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-electron": {
      "root": "packages/maximal-electron",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-data-visualization": {
      "root": "packages/maximal-data-visualization",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-context-window": {
      "root": "packages/maximal-context-window",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-observability": {
      "root": "packages/maximal-observability",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-observability-contract": {
      "root": "packages/maximal-observability-contract",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-model-contract": {
      "root": "packages/maximal-model-contract",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "maximal-client": {
      "root": "packages/maximal/client",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/omlx": {
      "root": "packages/model-runtimes/omlx",
      "cycleEdges": [],
      "duplicatePairs": []
    }
  },
  "packageRules": {
    "deny": [
      {
        "from": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-models",
          "@stuffbucket/maximal"
        ],
        "to": ["@stuffbucket/anthropic-provider", "@stuffbucket/omlx"]
      },
      {
        "from": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-model-contract"
        ],
        "to": [
          "@deepseek-ai/cordis",
          "@deepseek-ai/dsh-llm",
          "@deepseek-ai/schemastery"
        ]
      },
      {
        "from": ["@stuffbucket/anthropic-provider", "@stuffbucket/omlx"],
        "to": [
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-models",
          "@stuffbucket/maximal-model-contract"
        ]
      },
      {
        "from": ["@stuffbucket/maximal-electron"],
        "to": [
          "maximal-client",
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-data-visualization",
          "@stuffbucket/maximal-context-window",
          "@stuffbucket/maximal-observability"
        ]
      },
      {
        "from": ["@stuffbucket/maximal-data-visualization"],
        "to": [
          "maximal-client",
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-context-window",
          "@stuffbucket/maximal-observability",
          "@stuffbucket/maximal-observability-contract"
        ]
      },
      {
        "from": ["@stuffbucket/maximal-context-window"],
        "to": [
          "maximal-client",
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-observability"
        ]
      }
    ],
    "require": [
      {
        "from": "@stuffbucket/maximal-core",
        "to": ["@stuffbucket/maximal-model-contract"]
      },
      {
        "from": "@stuffbucket/maximal-models",
        "to": ["@stuffbucket/maximal-model-contract"]
      },
      {
        "from": "@stuffbucket/maximal",
        "to": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-models",
          "@stuffbucket/maximal-model-contract"
        ]
      }
    ]
  }
}