    },
    "@stuffbucket/maximal-dsh-host": {
      "root": "packages/maximal-dsh-host",
      "cycleEdges": [],
      "duplicatePairs": []
    },
    "@stuffbucket/maximal-electron": {
      "root": "packages/maximal-electron",
