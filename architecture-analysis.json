  "packageRules": {
    "deny": [
      {
        "from": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-dsh-host",
          "@stuffbucket/maximal"
        ],
        "to": ["@stuffbucket/anthropic-provider", "@stuffbucket/omlx"]
      },
      {
        "from": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-provider-contract"
        ],
        "to": [
          "@deepseek-ai/cordis",
          "@deepseek-ai/dsh-llm",
          "@deepseek-ai/schemastery"
        ]
      },
      {
        "from": ["@stuffbucket/anthropic-provider", "@stuffbucket/omlx"],
        "to": [
          "@stuffbucket/maximal",
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-dsh-host",
          "@stuffbucket/maximal-provider-contract"
        ]
      },
      {
        "from": ["@stuffbucket/maximal-electron"],
        "to": ["maximal-client", "@stuffbucket/maximal-core"]
      }
    ],
    "require": [
      {
        "from": "@stuffbucket/maximal-core",
        "to": ["@stuffbucket/maximal-provider-contract"]
      },
      {
        "from": "@stuffbucket/maximal-dsh-host",
        "to": ["@stuffbucket/maximal-provider-contract"]
      },
      {
        "from": "@stuffbucket/maximal",
        "to": [
          "@stuffbucket/maximal-core",
          "@stuffbucket/maximal-dsh-host",
          "@stuffbucket/maximal-provider-contract"
        ]
      }
    ]
  }
