{
  "name": "maximal-desktop",
  "description": "Electron host and distribution for the Maximal client.",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "productName": "Maximal",
  "main": ".vite/build/main.js",
  "scripts": {
    "analyze": "bun ../../packages/maximal-core/scripts/analyze.ts",
    "build": "bun scripts/build-core.ts",
    "build:core": "bun scripts/build-core.ts",
    "typecheck": "node ../../scripts/run-workspace-task.mjs typecheck",
    "typecheck:inner": "tsc --noEmit && tsc --noEmit -p sidecar",
    "lint": "node ../../scripts/run-workspace-task.mjs lint",
    "lint:inner": "eslint src sidecar scripts e2e eslint.config.mjs forge.config.ts forge.env.d.ts playwright.config.ts vite.*.config.mts vitest.config.mts",
    "mutate": "stryker run",
    "test": "vitest run && bun test",
    "test:settings": "vitest run src/main/preferences/application-settings.test.ts src/main/adapters/harness-options.test.ts src/main/adapters/terminal-shutdown.test.ts",
    "dev": "node scripts/start.mjs",
    "dev:server": "bun run --watch ./sidecar/main.ts",
    "start": "node scripts/start.mjs",
    "generate:licenses": "node scripts/generate-licenses.mjs",
    "package": "electron-forge package",
    "verify:package": "node scripts/verify-package.mjs",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icon-png.mjs",
    "predev": "pnpm run generate:licenses && node scripts/gen-icon-png.mjs",
    "prestart": "node scripts/gen-icon-png.mjs",
    "prepackage": "pnpm run generate:licenses && node scripts/gen-icon-png.mjs"
  },
  "dependencies": {
    "@maximal/local-model-registry": "workspace:*",
    "@maximal/maximal-assets": "workspace:*",
    "@maximal/maximal-browser": "workspace:*",
    "@maximal/maximal-client": "workspace:*",
    "@maximal/maximal-configurators": "workspace:*",
    "@maximal/maximal-core": "workspace:*",
    "@maximal/maximal-core-contract": "workspace:*",
    "@maximal/maximal-electron": "workspace:*",
    "@maximal/maximal-harness": "workspace:*",
    "@maximal/maximal-runner-llama-cpp": "workspace:*",
    "@maximal/maximal-logging": "workspace:*",
    "@maximal/maximal-model-contract": "workspace:*",
    "@maximal/maximal-models": "workspace:*",
    "@maximal/maximal-observability": "workspace:*",
    "@maximal/maximal-observability-contract": "workspace:*",
    "@maximal/maximal-ollama": "workspace:*",
    "@maximal/maximal-recording": "workspace:*",
    "@maximal/project-catalog": "workspace:*",
    "@maximal/maximal-settings": "workspace:*",
    "@maximal/maximal-terminal": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "uiohook-napi": "1.5.5",
    "pixi.js": "8.21.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-base": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/asar": "^4.3.0",
    "@electron/packager": "^20.3.0",
    "@maximal/eslint-config": "workspace:*",
    "@maximal/maximal-project-browser": "workspace:*",
    "@maximal/maximal-react-component": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "44.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
