{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["packages", "packageRules"],
  "properties": {
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["root"],
        "properties": {
          "root": { "type": "string" },
          "existingRatchets": { "type": "boolean" },
          "cycleEdges": { "type": "array", "items": { "type": "string" } },
          "duplicatePairs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "packageRules": {
      "type": "object",
      "required": ["deny", "require"],
      "properties": {
        "deny": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "array", "items": { "type": "string" } },
              "to": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "require": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}